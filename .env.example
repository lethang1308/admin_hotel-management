# ===================================================================
# Reusable Spring Boot Base - Environment Configuration Template
# Copy this file to .env and fill in values for your environment.
# NEVER commit your real .env file to Git!
# ===================================================================

# Spring Profile: dev | test | prod
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
APP_NAME=Enterprise Management System
# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hotel_management
DB_USERNAME=root
DB_PASSWORD=

# JWT Configuration (Minimum 32 characters / 256-bit HMAC key)
# Generate one via: openssl rand -base64 48
JWT_SIGNING_KEY=replace-with-at-least-32-character-random-secret-key-for-hmac-sha256
JWT_ACCESS_EXPIRATION_SECONDS=900
JWT_REFRESH_EXPIRATION_SECONDS=604800

# CORS Allowed Origins (Comma-separated for React/Vite frontend)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional Development Admin Seed (ONLY runs in 'dev' profile when APP_SEED_ADMIN_ENABLED=true)
APP_SEED_ADMIN_ENABLED=false
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=
ADMIN_SEED_FULL_NAME=System Administrator

# Base64-encoded 32-byte key for encrypted customer identity documents. Keep stable and private.
CUSTOMER_DOCUMENT_ENCRYPTION_KEY=

# Guest email queue (enable only after configuring an SMTP server)
GUEST_MAIL_ENABLED=false
GUEST_MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true

# Public website origin used for password-reset links
FRONTEND_URL=http://localhost:5173
